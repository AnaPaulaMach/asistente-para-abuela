# Va en la Pi: ~/.config/asistente/ajustes.env
NOMBRE_ASISTENTE=Beto
# Lo completa solo telegram_prueba.py la primera vez (el chat que recibe los avisos):
TELEGRAM_CHAT_ID=
# Para el clima (Open-Meteo): latitud y longitud de la casa, aproximadas alcanza.
CLIMA_LAT=-34.60
CLIMA_LON=-58.38
# Para las noticias (titulares de Google Noticias que nombran este lugar):
NOTICIAS_LUGAR=Mi Ciudad
# Buen día, chequeo de la mañana (si no tocó el botón, avisa) y luz de noche (horas)
BUEN_DIA=09:00
CHEQUEO=11:00
NOCHE=21-7
